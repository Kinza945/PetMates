# PetMates Android local env example
#
# Вариант 1: передать через Gradle properties:
# .\gradlew.bat :app:assembleDebug -PUSE_MOCKS=false -PSUPABASE_URL=https://your-project.supabase.co -PSUPABASE_ANON_KEY=your-anon-key
#
# Вариант 2: передать через переменные окружения PowerShell:
# $env:USE_MOCKS="false"
# $env:SUPABASE_URL="https://your-project.supabase.co"
# $env:SUPABASE_ANON_KEY="your-anon-key"
# .\gradlew.bat :app:assembleDebug

USE_MOCKS=true
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-public-anon-key

# ВАЖНО:
# Никогда не добавлять SUPABASE_SERVICE_ROLE_KEY в Android-проект.
# service_role нужен только backend/server-side коду и SQL/admin-проверкам.
